# 실제 키는 .env에만 넣는다 (커밋 금지)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 선택: 기본 모델(claude-haiku-5-5)을 바꿀 때만
TAX_AGENT_MODEL=
LANGFUSE_PUBLIC_KEY=
